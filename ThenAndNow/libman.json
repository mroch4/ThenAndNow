{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "leaflet@1.9.4",
      "destination": "wwwroot/lib/leaflet/",
      "files": [
        "leaflet.min.js",
        "leaflet.min.css"
      ]
    },
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "bootstrap.min.js",
        "bootstrap.min.css"
      ]
    },
    {
      "library": "firebase@12.3.0",
      "destination": "wwwroot/lib/firebase/",
      "files": [
        "firebase-app.js",
        "firebase-auth.js",
        "firebase-database.js"
      ]
    }
  ]
}