@using ThenAndNow.Enums

<button class="btn btn-sm btn-social @Name">
    @if (Type == SocialMediaType.Copy)
    {
        if (Copied)
        {
            <img alt="@Name" height="@Size" src="@("icons/socials/copied.svg")" width="@Size" />
        }
        else
        {
            <img alt="@Name" height="@Size" src="@($"icons/socials/{Name}.svg")" width="@Size" @onclick="CopyToClipboard" />
        }
    }
    else
    {
        <a href="@(Route + DirectUrl)" rel="noopener noreferrer" target="_blank">
            <img alt="@Name" height="@Size" src="@($"icons/socials/{Name}.svg")" width="@Size" />
        </a>
    }
</button>
