@using System.Globalization

<div class="d-flex flex-column">
    <div class="d-flex justify-content-between align-content-center mb-3">
        <div class="d-flex flex-wrap gap-2">
            @foreach (var buttonType in SocialButtons)
            {
                <ShareButton Type="buttonType" DirectUrl="@DirectUrl" />
            }
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleReplies">@(ShowReplies? Labels.HideReplies: Labels.ShowReplies)</button>
    </div>
    <div class="d-flex flex-column">
        @if (ShowReplies)
        {
            @if (Replies.Any())
            {
                <div class="d-flex flex-column">
                    @foreach (var reply in Replies)
                    {
                        <div class="d-flex flex-column mb-2">
                            <span class="text-muted">@reply.Name | @reply.Timestamp.ToString("F", new CultureInfo("pl-PL"))</span>
                            <span>@reply.Content</span>
                        </div>
                    }
                </div>
            }
            <a class="text-center" @onclick="AuthUser">AuthUser</a>
            <a class="text-center" @onclick="ShowModal">ShowModal</a>
        }
    </div>
</div>