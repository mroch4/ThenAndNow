@using System.Globalization
<div class="d-flex flex-column">
    <div class="d-flex justify-content-between align-content-center mb-2">
        <div class="d-flex flex-wrap gap-2">
            @foreach (var buttonType in SocialButtons)
            {
                <ShareButton Type="buttonType" DirectUrl="@DirectUrl" />
            }
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleReplies">@(ShowReplies? Labels.HideReplies: Labels.ShowReplies)</button>
    </div>
    <div class="d-flex">
        @if (ShowReplies)
        {
            @if (Replies.Any())
            {
                <div class="d-flex flex-column">
                    @foreach (var reply in Replies)
                    {
                        <div class="d-flex flex-column mb-2">
                            <code>@reply.Name | @reply.Timestamp.ToString("f", new CultureInfo("pl-PL"))</code>
                            <code>@reply.Content</code>
                        </div>
                    }
                </div>
            }
            else
            {
                <a class="text-center" @onclick="AddReply">@Labels.AddReply</a>
            }
        }
    </div>
</div>