<div class="d-flex flex-column">
    <div class="d-flex justify-content-between align-content-center mb-3">
        <div class="d-flex flex-wrap gap-2">
            @foreach (var buttonType in SocialButtons)
            {
                <ShareButton Type="buttonType" DirectUrl="@DirectUrl" />
            }
        </div>
        <button class="btn btn-sm btn-light" @onclick="ToggleReplies">@(ShowReplies? Labels.HideReplies: Labels.ShowReplies)</button>
    </div>
    <div class="d-flex flex-column">
        @if (ShowReplies)
        {
            <Loader DataLoaded="DataLoaded">
                @if (Replies.Any())
                {
                    <div class="d-flex flex-column border border-secondary-subtle gap-3 p-3" style="max-height: 300px; overflow-y: auto;">
                        @*<Virtualize Context="reply" Items="Replies" ItemSize="500">
                            <ReplyComponent Reply="reply" @key="reply.Id" />
                        </Virtualize> *@
                        @foreach (var reply in Replies)
                        {
                            <ReplyComponent Reply="reply" @key="reply.Id" />
                        }
                    </div>
                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-sm btn-light" @onclick="AddReply">@Labels.AddReply</button>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-end mt-2 gap-2">
                        <button class="btn btn-sm btn-danger" @onclick="AuthUser">AuthUser</button>
                        <button class="btn btn-sm btn-light" @onclick="AddReply">@Labels.AddFirstReply</button>
                    </div>
                }
            </Loader>
        }
    </div>
</div>